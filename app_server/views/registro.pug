extends layout

block content
  .cb-page
    header.cb-topbar
      a.cb-brand(href='/')
        span.cb-brand-mark C
        span Commission Board
    main.cb-auth
      section.cb-card.cb-auth-card
        span.cb-kicker Nueva cuenta
        h1 Crea tu espacio
        p.cb-muted Tu moodboard personal para organizar comisiones y referencias.
        if error
          .cb-notice.cb-notice-error= error
        form(action='/register', method='post')
          label.cb-label(for='nombre') Nombre
          input#nombre.cb-input(type='text', name='nombre', placeholder='Tu nombre', required)
          label.cb-label(for='email') Correo electrónico
          input#email.cb-input(type='email', name='email', placeholder='tu@email.com', required)
          label.cb-label(for='password') Contraseña
          input#password.cb-input(type='password', name='password', minlength='4', required)
          button.cb-button.cb-button-full(type='submit')
            i.bi.bi-person-plus
            | Crear cuenta
        p.cb-auth-footer ¿Ya tienes cuenta? #[a.cb-link(href='/') Inicia sesión]
